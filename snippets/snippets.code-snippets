      "    </ul>",
      "  </nav>",
      "</header>",
      "",
      "  .${1:mi-clase} {",
      "    background-color: #333;",
      "    padding: 1rem 2rem;",
      "    display: flex;",
      "    justify-content: space-between;",
      "    align-items: center;",
      "  }",
