{
  "Botón Efecto Líquido": {
    "prefix": "btn-li",
    "body": [
      "  /*ESTILOS PARA BOTÓN */",
      "  .btn-liquido {",
      "    position: relative;",
      "    padding: 16px 40px;",
      "    font-size: 18px;",
      "    font-weight: bold;",
      "    color: white;",
      "    background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);",
      "    border: none;",
      "    border-radius: 50px;",
      "    cursor: pointer;",
      "    overflow: hidden;",
      "    z-index: 1;",
      "    transition: color 0.4s ease;",
      "  }",
      "  ",
      "  .btn-liquido::before {",
      "    content: '';",
      "    position: absolute;",
      "    top: 0;",
      "    left: 0;",
      "    width: 100%;",
      "    height: 100%;",
      "    background: linear-gradient(90deg, #764ba2 0%, #667eea 100%);",
      "    border-radius: 50px;",
      "    z-index: -1;",
      "    transform: scaleX(0);",
      "    transform-origin: right;",
      "    transition: transform 0.6s cubic-bezier(0.83, 0, 0.17, 1);",
      "  }",
      "  ",
      "  .btn-liquido:hover {",
      "    color: white;",
      "  }",
      "  ",
      "  .btn-liquido:hover::before {",
      "    transform: scaleX(1);",
      "    transform-origin: left;",
      "  }"
    ],
    "description": "Botón con efecto líquido al hover. El fondo se llena suavemente de izquierda a derecha."
  },
  "Maquina de Escribir": {
    "prefix": "typewriter",
    "body": [
      "p {",
      "  display: inline-block;",
      "  overflow: hidden;",
      "  border-right: 3px solid #00ff00;",
      "  white-space: nowrap;",
      "  letter-spacing: 2px;",
      "  font-family: 'Courier New', monospace;",
      "  animation: typing 3.5s steps(30, end) infinite, blink 0.75s step-end infinite;",
      "}",
      "",
      "@keyframes typing {",
      "  0% { width: 0; }",
      "  80% { width: 100%; }",
      "  100% { width: 100%; }",
      "}",
      "",
      "@keyframes blink {",
      "  from, to { border-color: transparent }",
      "  50% { border-color: #00ff00; }",
      "}"
    ],
    "description": "Animación de máquina de escribir que se repite infinitamente. Aplica a etiquetas <p>."
  },
  "Botón Neon": {
    "prefix": "btn-neon",
    "body": [
      "button {",
      "  padding: 15px 35px;",
      "  font-size: 18px;",
      "  font-weight: bold;",
      "  color: white;",
      "  background: #111;",
      "  border: 2px solid transparent;",
      "  border-radius: 8px;",
      "  cursor: pointer;",
      "  position: relative;",
      "  transition: all 0.3s ease;",
      "}",
      "",
      "button:hover {",
      "  color: #fff;",
      "  background: #111;",
      "  border: 2px solid transparent;",
      "  box-shadow: ",
      "    0 0 10px #ff0080,",
      "    0 0 20px #ff0080,",
      "    0 0 30px #ff0080,",
      "    0 0 40px #00ccff,",
      "    0 0 70px #00ccff,",
      "    0 0 80px #00ccff;",
      "  animation: neon-pulse 1.5s infinite alternate;",
      "}",
      "",
      "@keyframes neon-pulse {",
      "  0% {",
      "    box-shadow: ",
      "      0 0 10px #ff0080,",
      "      0 0 20px #ff0080,",
      "      0 0 30px #ff0080,",
      "      0 0 40px #00ccff,",
      "      0 0 70px #00ccff,",
      "      0 0 80px #00ccff;",
      "  }",
      "  100% {",
      "    box-shadow: ",
      "      0 0 15px #ff0080,",
      "      0 0 25px #ff0080,",
      "      0 0 35px #ff0080,",
      "      0 0 50px #00ccff,",
      "      0 0 85px #00ccff,",
      "      0 0 95px #00ccff;",
      "  }",
      "}"
    ],
    "description": "Botón con efecto neón multicolor y pulso suave al hover. Aplica a etiquetas <button>."
  },
  "Botón Cargando": {
    "prefix": "btn-loa",
    "body": [
      "button {",
      "  width: 150px;",
      "  height: 50px;",
      "  background: #3b82f6;",
      "  color: white;",
      "  border: none;",
      "  border-radius: 8px;",
      "  font-size: 16px;",
      "  font-weight: bold;",
      "  cursor: pointer;",
      "  transition: all 0.4s ease;",
      "  position: relative;",
      "  overflow: hidden;",
      "}",
      "",
      "button.loading {",
      "  width: 50px;",
      "  height: 50px;",
      "  border-radius: 50%;",
      "  background: #3b82f6;",
      "  color: transparent;",
      "}",
      "",
      "button.loading::after {",
      "  content: '';",
      "  position: absolute;",
      "  width: 30px;",
      "  height: 30px;",
      "  top: 10px;",
      "  left: 10px;",
      "  border: 3px solid transparent;",
      "  border-top: 3px solid white;",
      "  border-radius: 50%;",
      "  animation: spin 0.8s linear infinite;",
      "}",
      "",
      "@keyframes spin {",
      "  0% { transform: rotate(0deg); }",
      "  100% { transform: rotate(360deg); }",
      "}",
      "",
      "",
      "/* document.querySelector('button').addEventListener('click', function() {",
      "  this.classList.add('loading');",
      "  //    ESTO ES EL JS",
      "   setTimeout(() => {",
      "    this.classList.remove('loading');",
      "     this.textContent = 'Enviado ✅';",
      " }, 3000);",
      "",
      "   setTimeout(() => {",
      "     this.textContent = 'Enviar'",
      "  }, 8000)",
      "});",
      "",
      "",
      "*/"
    ],
    "description": "Animacion de boton de carga al hacer click. El botón se convierte en un círculo con un spinner."
  },
  "tarjeta-3d": {
    "prefix": "card-3d",
    "body": [
      ".card-flip-container {",
      "  width: 300px;",
      "  height: 200px;",
      "  perspective: 1000px;",
      "  cursor: pointer;",
      "}",
      "",
      ".card-flip {",
      "  width: 100%;",
      "  height: 100%;",
      "  position: relative;",
      "  transform-style: preserve-3d;",
      "  transition: transform 0.8s;",
      "}",
      "",
      ".card-flip-container:hover .card-flip {",
      "  transform: rotateY(180deg);",
      "}",
      "",
      ".card-front, .card-back {",
      "  position: absolute;",
      "  width: 100%;",
      "  height: 100%;",
      "  backface-visibility: hidden;",
      "  border-radius: 10px;",
      "  padding: 20px;",
      "  box-sizing: border-box;",
      "  display: flex;",
      "  align-items: center;",
      "  justify-content: center;",
      "  flex-direction: column;",
      "}",
      "",
      ".card-front {",
      "  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);",
      "  color: white;",
      "}",
      "",
      ".card-back {",
      "  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);",
      "  color: white;",
      "  transform: rotateY(180deg);",
      "}",
      "",
      "/* EL HTML",
      "<div class=\"card-flip-container\">",
      "  <div class=\"card-flip\">",
      "    <!-- Cara frontal -->",
      "    <div class=\"card-front\">",
      "      <h3>Frente</h3>",
      "      <p>Contenido frontal aquí</p>",
      "    </div>",
      "    ",
      "    <!-- Cara trasera -->",
      "    <div class=\"card-back\">",
      "      <h3>Reverso</h3>",
      "      <p>Contenido trasero aquí</p>",
      "    </div>",
      "  </div>",
      "</div>",
      " */"
    ],
    "description": "Tarjeta con efecto de volteo 3D al pasar el cursor. Muestra contenido diferente en el frente y reverso."
  },
