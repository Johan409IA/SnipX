{
  "name": "snipx",
  "displayName": "SnipX",
  "publisher": "johan-dev",
  "description": "Extensión de snippets para componentes HTML diversos con sus estilos, y para CSS en cuanto animaciones y atajos de estilos.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Snippets"
  ],
  "icon": "snipX-logo.png",
  "contributes": {
    "snippets": [
      {
        "language": "html",
        "path": "./snippets/snippets.code-snippets"
      },
      {
        "language": "css",
        "path": "./snippets/css-snippets.code-snippets"
      }
    ]
  }
}
